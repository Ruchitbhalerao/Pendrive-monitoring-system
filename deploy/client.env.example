# /etc/exam-monitor/client.env
# Configuration for the USB monitoring agent on one lab PC.
# Keep this file root-readable only:
#   install -m 0640 deploy/client.env.example /etc/exam-monitor/client.env
#   chown root:exam-monitor /etc/exam-monitor/client.env

# Unique identifier for THIS computer, e.g. LAB-PC-01.
COMPUTER_ID=LAB-PC-01

# Base URL of the central server on the lab LAN.
SERVER_URL=http://192.168.1.10:5000

# Must match the server's AUTH_TOKEN (ingestion token, not the dashboard token).
AUTH_TOKEN=replace-with-the-server-ingestion-token

# Persistent outbox on the service account's writable directory.
CLIENT_DB_PATH=/var/lib/exam-monitor/client_outbox.db

# Seconds between delivery retry cycles.
RETRY_INTERVAL=5

# HTTP request timeout in seconds.
REQUEST_TIMEOUT=10

# Seconds between heartbeats (keep below the server's STALE_AFTER_SECONDS).
HEARTBEAT_INTERVAL_SECONDS=30
