# /etc/exam-monitor/server.env
# Secrets for the central server. Keep this file root-readable only:
#   install -m 0640 deploy/server.env.example /etc/exam-monitor/server.env
#   chown root:exam-monitor /etc/exam-monitor/server.env
#
# Generate strong tokens with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

APP_ENV=production

# SQLite database on persistent storage owned by the service account.
DATABASE_PATH=/var/lib/exam-monitor/exam_monitor.db

# Bind to all interfaces so lab PCs on the LAN can reach the server. Only open
# the firewall for your lab subnet (see README).
HOST=0.0.0.0
PORT=5000

# Client ingestion token (POST /api/events, POST /api/heartbeat).
AUTH_TOKEN=replace-with-a-long-random-ingestion-token

# Dashboard login password and read-API bearer token. MUST differ from AUTH_TOKEN.
DASHBOARD_TOKEN=replace-with-a-different-long-random-dashboard-token

# Signs the browser session cookie. MUST be a long random value, unique per host.
SECRET_KEY=replace-with-a-long-random-session-secret-at-least-16-chars

# Dashboard online/stale threshold (seconds).
STALE_AFTER_SECONDS=90

# SQLite lock wait (milliseconds).
SQLITE_BUSY_TIMEOUT_MS=5000

# Browser session lifetime (hours).
SESSION_LIFETIME_HOURS=12

# Set to true only when serving over HTTPS (recommended). Behind plain HTTP on
# an isolated lab LAN, leave false: a Secure cookie would not be sent.
SESSION_COOKIE_SECURE=false
