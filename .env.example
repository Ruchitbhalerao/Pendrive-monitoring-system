# Example configuration for the USB monitoring server.
# The project reads plain environment variables; it does NOT load this file
# automatically (no python-dotenv). Export these values in your shell instead.
#
# macOS / Linux (bash/zsh):
#   export AUTH_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
#   export DASHBOARD_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
#   export SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
#   export DATABASE_PATH="./exam_monitor.db"
#   export HOST="127.0.0.1"
#   export PORT="5000"

# Deployment environment: "development" (default) or "production".
# In production, missing/weak secrets cause startup to fail with a clear error.
APP_ENV=development

# Path to the SQLite database file. Defaults to exam_monitor.db in project root.
DATABASE_PATH=./exam_monitor.db

# ---------------------------------------------------------------------------
# Secrets (two INDEPENDENT tokens). Never commit real values.
# ---------------------------------------------------------------------------

# Client ingestion token. Agents send it to POST /api/events and /api/heartbeat.
AUTH_TOKEN=replace-with-a-long-random-ingestion-token

# Dashboard login password and read-API bearer token. MUST differ from AUTH_TOKEN.
DASHBOARD_TOKEN=replace-with-a-different-long-random-dashboard-token

# Signs the browser session cookie. Required in production; in development an
# ephemeral key is generated if omitted (sessions reset on restart).
SECRET_KEY=replace-with-a-long-random-session-secret-at-least-16-chars

# Interface to bind. Use 0.0.0.0 to accept connections from the lab LAN.
HOST=127.0.0.1

# TCP port for the server.
PORT=5000

# Dashboard: a computer counts as "online" when its last heartbeat arrived
# within this many seconds. Reflects live client health, not event activity.
STALE_AFTER_SECONDS=90

# SQLite lock wait in milliseconds (WAL mode is always enabled for on-disk DBs).
SQLITE_BUSY_TIMEOUT_MS=5000

# Browser session lifetime in hours. Default 12.
SESSION_LIFETIME_HOURS=12

# Set true only when the dashboard is served over HTTPS. Leave false on a plain
# HTTP lab LAN, because a Secure cookie is never sent over http.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Client (USB monitoring agent) settings
# Run the client on each Ubuntu lab computer. Same AUTH_TOKEN as the server.
# ---------------------------------------------------------------------------

# Unique identifier for this computer, e.g. LAB-PC-01. REQUIRED.
COMPUTER_ID=LAB-PC-01

# Base URL of the Flask server on the LAN. REQUIRED.
# Use the server's LAN IP so other machines can reach it (server HOST=0.0.0.0).
# Plain http:// sends the bearer token in the clear on the LAN; prefer https://
# in production where practical. Token auth does NOT encrypt HTTP.
SERVER_URL=http://192.168.1.10:5000

# Local SQLite queue database. Defaults to client_outbox.db in the project root.
CLIENT_DB_PATH=./client_outbox.db

# Seconds to wait between delivery retry cycles. Default 5.
RETRY_INTERVAL=5

# HTTP request timeout in seconds. Default 10.
REQUEST_TIMEOUT=10

# Seconds between heartbeats. The client POSTs to /api/heartbeat so the
# dashboard can show whether the agent is alive, even with no USB activity.
# Must be comfortably smaller than the server's STALE_AFTER_SECONDS. Default 30.
HEARTBEAT_INTERVAL_SECONDS=30
